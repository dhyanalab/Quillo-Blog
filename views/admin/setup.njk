{% extends "admin/layout.njk" %}
{% set title = "Set up your blog" %}
{% block auth %}
<section class="card auth-card">
  <h1>Set up your blog</h1>
  <p class="lede">Name your blog and create the owner account. You can change everything else later in Settings.</p>
  {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="{{ A }}/setup" class="form">
    <input type="hidden" name="_csrf" value="{{ token }}">
    <label class="field"><span>Setup token</span><input name="setup_token" required autocomplete="off" spellcheck="false" maxlength="200"><small>Printed in the server’s console when it started, or the SETUP_TOKEN value from its environment. It stops strangers from claiming a new blog.</small></label>
    <label class="field"><span>Blog name</span><input name="site_title" value="{{ values.site_title }}" required maxlength="100" placeholder="e.g. The Weekend Kitchen"></label>
    <label class="field"><span>What your blog is about <small>optional, up to 155 characters</small></span><input name="site_description" value="{{ values.site_description }}" maxlength="155" placeholder="e.g. Simple recipes and kitchen tips for busy weekends."><small>Search engines show this under your blog’s name.</small></label>
    <label class="field"><span>Site URL</span><input name="site_url" type="url" value="{{ values.site_url }}" required><small>The public address, e.g. https://blog.example.com. Used for canonical URLs, the sitemap and social cards.</small></label>
    <label class="field"><span>Time zone</span><select name="timezone" data-guess-zone>{% for z in zones %}<option{% if z == values.timezone %} selected{% endif %}>{{ z }}</option>{% endfor %}</select><small>Post dates and scheduled publishing use it.</small></label>
    <label class="field"><span>Your name</span><input name="name" value="{{ values.name }}" required autocomplete="name" maxlength="100"></label>
    <label class="field"><span>Email</span><input name="email" type="email" value="{{ values.email }}" required autocomplete="email" maxlength="200"></label>
    <label class="field"><span>Password</span><input name="password" type="password" required minlength="10" maxlength="256" autocomplete="new-password"><small>At least 10 characters.</small></label>
    <label class="check"><input type="checkbox" name="show_powered_by" value="1"{% if values.powered_by %} checked{% endif %}> Show a small “Powered by {{ product.name }}” line in the footer</label>
    <button class="btn btn-primary btn-wide" type="submit">Create owner account</button>
  </form>
</section>
{% endblock %}
