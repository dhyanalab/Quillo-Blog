# Quillo server settings. Copy this file to the server (for systemd: /etc/quillo.env, owner-only, chmod 600)
# and point the service at it with EnvironmentFile=. Lines starting with # are ignored; remove the # to use a setting.
# Every setting is explained in README.md under "Configuration".

# Where the server listens. Keep 127.0.0.1 when a proxy or tunnel (nginx, Caddy, Cloudflare Tunnel) sits in front.
HOST=127.0.0.1
PORT=4100

# The blog's public address. Set it in production so links in feeds, emails and the sitemap can't be changed from the admin.
SITE_URL=https://blog.example.com

# Turn on only when a proxy or tunnel is in front and the port above can't be reached directly.
TRUST_PROXY=1
# How many proxies sit in front (Cloudflare Tunnel alone: 1).
PROXY_HOPS=1

# Needed once, to create the owner account. Leave it unset to get a random one printed at start-up.
# SETUP_TOKEN=

# Where the database, uploads and secret.key live (default ./data).
# DATA_DIR=/home/you/quillo/data

# Serve the blog from a folder instead of the whole domain, e.g. /blog.
# BASE_PATH=

# 64 hex characters (openssl rand -hex 32). Without it a key is made once in DATA_DIR/secret.key. Back it up either way.
# APP_SECRET=

# Largest image upload in MB (1 to 500).
# MAX_UPLOAD_MB=15

# Answer the admin only on this host name (no https://), e.g. admin.example.com.
# ADMIN_HOST=

# 1 adds includeSubDomains to the HTTPS-only header. Only when every sub-domain is served over HTTPS.
# HSTS_SUBDOMAINS=

# 0 stops half-sent newsletters from carrying on at start-up (use after restoring a backup).
# RESUME_NEWSLETTERS=

# Escape hatches for upgrades; use knowingly, once.
# ALLOW_MIGRATION_DRIFT=
# ALLOW_BACKUP_FAILURE=

# Connections one address may hold at once, when no proxy is in front (5 to 1024).
# MAX_CONNECTIONS_PER_IP=100

# 0 turns off IndexNow pings to search engines.
# BLOG_OUTBOUND=

# The software's name in the admin and the optional footer credit (resellers with a commercial licence).
# PRODUCT_NAME=Quillo

# Pin the mail server here instead of in the admin (SMTP_SECURE is ssl or starttls).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_SECURE=
# SMTP_PASSWORD=
# ALLOW_PRIVATE_SMTP=
# MAIL_DELAY_MS=400

# Never set development mode on a public site.
# NODE_ENV=production
