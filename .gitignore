# ---------------------------------------------------------------------------
# Never commit: a blog's live data, keys and secrets
# ---------------------------------------------------------------------------
data/
backups/
secret.key
key-check.txt
suppression-list.txt
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
id_rsa*
id_ed25519*

# Settings files with secrets (the documented template, .env.example, is kept)
.env
.env.*
!.env.example

# Database files, wherever DATA_DIR points
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.bak

# Packaged copies of a blog (they can hold the database and secret.key)
*.tar
*.tar.gz
*.tgz
*.zip
!test/fixtures/**/*.zip

# ---------------------------------------------------------------------------
# Generated, installed or temporary
# ---------------------------------------------------------------------------
node_modules/
test/output/
test-results/
playwright-report/
coverage/
.nyc_output/
tmp/
*.tmp
_site/
dist/

# Logs (the blog's audit.log and command-line.log live in data/)
*.log
logs/
npm-debug.log*

# ---------------------------------------------------------------------------
# Editors, tools and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.claude/
.DS_Store
Thumbs.db
desktop.ini
