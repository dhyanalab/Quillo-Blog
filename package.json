{
  "name": "quillo",
  "version": "1.0.0",
  "private": true,
  "description": "Quillo: a self-hosted blog platform (admin + public site) on Node, Hono and SQLite. One install per blog, no database server, no build step.",
  "license": "AGPL-3.0-or-later",
  "author": "Dhyana Engineering Solutions <info@dhyanalab.in>",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=src --watch-path=server.js server.js --dev",
    "seed": "node scripts/seed-demo.js",
    "user": "node scripts/user.js",
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify-pages.js",
    "flow": "node scripts/editor-flow.js",
    "build:editor": "node scripts/build-editor.js",
    "build:icons": "node scripts/build-icons.js",
    "set-version": "node scripts/set-version.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@hono/node-server": "2.1.6",
    "@toast-ui/editor": "3.2.2",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "hono": "4.13.16",
    "markdown-it": "15.0.3",
    "nodemailer": "10.1.7",
    "nunjucks": "3.2.4",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.64.1",
    "simple-icons": "16.35.0"
  },
  "overrides": {
    "fflate": "0.7.5",
    "dompurify": "$dompurify"
  },
  "main": "server.js"
}
